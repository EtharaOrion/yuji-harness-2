{
  "model": "claude-3-5-sonnet-latest",
  "max_tokens": 256,
  "tools": [{
    "name": "lookup",
    "description": "Look up a value by key.",
    "input_schema": {
      "type": "object",
      "properties": {"q": {"type": "string"}},
      "required": ["q"]
    }
  }],
  "messages": [
    {"role": "user", "content": "Use the lookup tool with q=\"x\"."},
    {"role": "assistant", "content": [
      {"type": "tool_use", "id": "toolu_call_a", "name": "lookup", "input": {"q": "x"}}
    ]},
    {"role": "user", "content": [
      {"type": "tool_result", "tool_use_id": "toolu_call_a", "content": "{\"ok\":true}"}
    ]}
  ]
}
